--- !u!114 &774763464
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 774763462}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 64a20e1f5d1f7dc4b8600f8614672384, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialoguePanel: {fileID: 2100256830}
  dialogueText: {fileID: 282207634}
  dialogueLines:
  - dialogueTitle: Starting Point, lock door
    sequence:
    - dialogue: I finally made it back.
      duration: 1.5
    - dialogue: I should lock the door and close the blinds before doing anything
        else.
      duration: 3
  - dialogueTitle: House Secured
    sequence:
    - dialogue: That should be enough for now.
      duration: 1.5
    - dialogue: Now I can upload my findings.
      duration: 1.5
    - dialogue: I need the disk first.
      duration: 1.5
  - dialogueTitle: Knock
    sequence:
    - dialogue: Was that a knock?
      duration: 1.5
    - dialogue: It was comming from outside.
      duration: 1.5
  - dialogueTitle: Find teeth box
    sequence:
    - dialogue: ...Teeth?
      duration: 1.5
    - dialogue: Is this someone's idea of a threat?
      duration: 1.5
  - dialogueTitle: Power Outage
    sequence:
    - dialogue: The power's out.
      duration: 1.5
    - dialogue: I think the breaker's somewhere outside.
      duration: 1.5
  - dialogueTitle: Return Home
    sequence:
    - dialogue: That should do it.
      duration: 1.5
    - dialogue: I need to hurry.
      duration: 1.5
  - dialogueTitle: Glint
    sequence:
    - dialogue: What's that glare through the window?
      duration: 1.5
  - dialogueTitle: Final Upload
    sequence:
    - dialogue: Oh God, they found me.
      duration: 1.5
    - dialogue: I need to get out of here once I finish uploading.
      duration: 1.5
  - dialogueTitle: Leaving
    sequence:
    - dialogue: Time to go. I just need my plane ticket.
      duration: 1.5
  onDialogueStarted:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 202617501}
        m_TargetAssemblyTypeName: InventoryUI, Assembly-CSharp
        m_MethodName: CloseInventory
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
